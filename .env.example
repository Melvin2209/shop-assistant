# Copy to .env.local. Every variable is optional.

# Without a key the app runs in MOCK mode: a scripted agent that calls the
# same tools, so the demo works for free. With a key it runs in REAL mode.
ANTHROPIC_API_KEY=

# Cheap, fast model used in real mode.
ANTHROPIC_MODEL=claude-haiku-5-5

# Force a mode regardless of the key: "mock" or "real".
# ASSISTANT_MODE=mock
